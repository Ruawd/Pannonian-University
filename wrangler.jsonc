{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pannonian-university",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-06-07",
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": [
      "/academics",
      "/academics/*",
      "/academics.html",
      "/curriculum",
      "/curriculum/*",
      "/curriculum.html",
      "/admissions",
      "/admissions/*",
      "/admissions.html",
      "/research",
      "/research/*",
      "/research.html",
      "/campus",
      "/campus/*",
      "/campus.html",
      "/contact",
      "/contact/*",
      "/contact.html"
    ],
    "not_found_handling": "404-page"
  }
}
